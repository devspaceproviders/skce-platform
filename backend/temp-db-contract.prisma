  createdAt           Timestamptz          @default(now())
  description         String?
  isActive            Boolean              @default(true)
  price               Int
  slug                String               @unique(map: "coursePackage_slug_key")
  title               String
  updatedAt           Timestamptz
  certificates        Certificate[]
  enrollments         Enrollment[]
  packageCourses      PackageCourse[]
  registrationIntents RegistrationIntent[]

  @@map("coursePackage")
}

model Enrollment {
  id           Int            @id(map: "enrollment_pkey") @default(autoincrement())
  completedAt  Timestamptz?
  courseId     Int?
  createdAt    Timestamptz    @default(now())
  enrolledAt   Timestamptz    @default(now())
  packageId    Int?
  status       String         @default("PENDING")
  studentId    Int
  updatedAt    Timestamptz
  userId       Int
  certificates Certificate[]
  payments     Payment[]
  course       Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade, map: "enrollment_courseId_fkey")
  package      CoursePackage? @relation(fields: [packageId], references: [id], onDelete: Cascade, map: "enrollment_packageId_fkey")
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade, map: "enrollment_studentId_fkey")
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade, map: "enrollment_userId_fkey")

  @@index([courseId], name: "enrollment_courseId_idx")
  @@index([packageId], name: "enrollment_packageId_idx")
  @@index([studentId], name: "enrollment_studentId_idx")
  @@index([userId], name: "enrollment_userId_idx")
  @@check(expression: "(status = ANY (ARRAY['ACTIVE'::text, 'COMPLETED'::text, 'CANCELLED'::text, 'PENDING'::text]))", map: "enrollment_status_check_b0c8bb64")
  @@map("enrollment")
}

model Certificate {
  id                Int            @id(map: "certificate_pkey") @default(autoincrement())
  certificateNumber String         @unique(map: "certificate_certificateNumber_key")
  certificateUrl    String?
  courseId          Int?
