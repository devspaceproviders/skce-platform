  @@index([approvalStatus], name: "liveSession_approvalStatus_idx")
  @@index([courseId], name: "liveSession_courseId_idx")
  @@index([courseId, startAt], name: "liveSession_courseId_startAt_idx")
  @@index([createdByUserId], name: "liveSession_createdByUserId_idx")
  @@index([reviewedByUserId], name: "liveSession_reviewedByUserId_idx")
  @@index([startAt], name: "liveSession_startAt_idx")
  @@index([status], name: "liveSession_status_idx")
  @@index([trainerId], name: "liveSession_trainerId_idx")
  @@check(expression: "(\"approvalStatus\" = ANY (ARRAY['DRAFT'::text, 'PENDING_REVIEW'::text, 'REJECTED'::text, 'PUBLISHED'::text, 'ARCHIVED'::text]))", map: "liveSession_approvalStatus_check_5f777b7a")
  @@check(expression: "(status = ANY (ARRAY['SCHEDULED'::text, 'LIVE'::text, 'COMPLETED'::text, 'CANCELLED'::text]))", map: "liveSession_status_check_a50348ac")
  @@map("liveSession")
}

model LiveSessionParticipation {
  id           Int          @id(map: "liveSessionParticipation_pkey") @default(autoincrement())
  createdAt    Timestamptz  @default(now())
  joinedAt     Timestamptz?
  leftAt       Timestamptz?
  participated Boolean      @default(false)
  sessionId    Int
  updatedAt    Timestamptz
  userId       Int
  session      LiveSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "liveSessionParticipation_sessionId_fkey")
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade, map: "liveSessionParticipation_userId_fkey")

  @@unique([sessionId, userId], map: "liveSessionParticipation_sessionId_userId_key")
  @@index([sessionId], name: "liveSessionParticipation_sessionId_idx")
  @@index([sessionId, participated], name: "liveSessionParticipation_sessionId_participated_idx")
  @@index([userId], name: "liveSessionParticipation_userId_idx")
  @@map("liveSessionParticipation")
}

model PackageCourse {
