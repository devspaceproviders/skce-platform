}

model Payment {
  id                   Int                 @id(map: "payment_pkey") @default(autoincrement())
  amount               Int
  createdAt            Timestamptz         @default(now())
  currency             String              @default("INR")
  enrollmentId         Int?
  method               String              @default("RAZORPAY")
  paidAt               Timestamptz?
  providerOrderId      String?
  providerPaymentId    String?
  providerSignature    String?
  status               String              @default("CREATED")
  updatedAt            Timestamptz
  userId               Int?
  registrationIntentId Int?                @unique(map: "payment_registrationIntentId_key")
  enrollment           Enrollment?         @relation(fields: [enrollmentId], references: [id], onDelete: SetNull, map: "payment_enrollmentId_fkey")
  registrationIntent   RegistrationIntent? @relation(fields: [registrationIntentId], references: [id], onDelete: SetNull, map: "payment_registrationIntentId_fkey")
  user                 User?               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "payment_userId_fkey")

  @@index([enrollmentId], name: "payment_enrollmentId_idx")
  @@index([providerOrderId], name: "payment_providerOrderId_idx")
  @@index([providerPaymentId], name: "payment_providerPaymentId_idx")
  @@index([userId], name: "payment_userId_idx")
  @@check(expression: "(method = ANY (ARRAY['RAZORPAY'::text, 'STRIPE'::text, 'UPI'::text, 'OTHER'::text]))", map: "payment_method_check_ed9d8d21")
  @@check(expression: "(status = ANY (ARRAY['CREATED'::text, 'PENDING'::text, 'SUCCESS'::text, 'FAILED'::text, 'REFUNDED'::text]))", map: "payment_status_check_c5a939c7")
  @@map("payment")
}

model TrainerActivity {
  id          Int            @id(map: "trainerActivity_pkey") @default(autoincrement())
  action      String
  actorUserId Int
  createdAt   Timestamptz    @default(now())
  description String
  entityId    Int?
  entityType  String
  metadata    String?
  trainerId   Int
  actorUser   User           @relation(fields: [actorUserId], references: [id], onDelete: Cascade, map: "trainerActivity_actorUserId_fkey")
  trainer     TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade, map: "trainerActivity_trainerId_fkey")

  @@index([action], name: "trainerActivity_action_idx")
  @@index([actorUserId], name: "trainerActivity_actorUserId_idx")
  @@index([entityType, entityId], name: "trainerActivity_entityType_entityId_idx")
  @@index([trainerId, createdAt], name: "trainerActivity_trainerId_createdAt_idx")
  @@index([trainerId], name: "trainerActivity_trainerId_idx")
  @@map("trainerActivity")
}

model TrainerCoursePermission {
  id                    Int            @id(map: "trainerCoursePermission_pkey") @default(autoincrement())
  canCreateAssessments  Boolean        @default(false)
  canCreateLiveSessions Boolean        @default(false)
  canManageContent      Boolean        @default(false)
  canTeach              Boolean        @default(true)
  courseId              Int
  createdAt             Timestamptz    @default(now())
  trainerId             Int
  updatedAt             Timestamptz
  course                Course         @relation(fields: [courseId], references: [id], onDelete: Cascade, map: "trainerCoursePermission_courseId_fkey")
  trainer               TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade, map: "trainerCoursePermission_trainerId_fkey")

  @@unique([trainerId, courseId], map: "trainerCoursePermission_trainerId_courseId_key")
  @@index([courseId], name: "trainerCoursePermission_courseId_idx")
  @@index([trainerId, canTeach], name: "trainerCoursePermission_trainerId_canTeach_idx")
  @@index([trainerId], name: "trainerCoursePermission_trainerId_idx")
  @@map("trainerCoursePermission")
}
