  createdByUser    User?        @relation(name: "courseModule_createdByUserId_fkey", fields: [createdByUserId], references: [id], onDelete: SetNull, map: "courseModule_createdByUserId_fkey")
  reviewedByUser   User?        @relation(name: "courseModule_reviewedByUserId_fkey", fields: [reviewedByUserId], references: [id], onDelete: SetNull, map: "courseModule_reviewedByUserId_fkey")

