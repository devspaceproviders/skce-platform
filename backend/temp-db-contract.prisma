// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model Course {
  id                       Int                       @id(map: "course_pkey") @default(autoincrement())
  createdAt                Timestamptz               @default(now())
  description              String?
  duration                 String?
  isActive                 Boolean                   @default(true)
  mode                     String                    @default("ONLINE")
  modules                  Int?
  slug                     String                    @unique(map: "course_slug_key")
  title                    String
  updatedAt                Timestamptz
  price                    Int?
  assessments              Assessment[]
  batches                  Batch[]
  certificates             Certificate[]
  courseModules            CourseModule[]
  enrollments              Enrollment[]
  liveSessions             LiveSession[]
  packageCourses           PackageCourse[]
  registrationIntents      RegistrationIntent[]
  trainerCoursePermissions TrainerCoursePermission[]

  @@check(expression: "(mode = ANY (ARRAY['ONLINE'::text, 'OFFLINE'::text, 'HYBRID'::text]))", map: "course_mode_check_8ab134e1")
  @@map("course")
}

model User {
  id                        Int                        @id(map: "user_pkey") @default(autoincrement())
  createdAt                 Timestamptz                @default(now())
  email                     String                     @unique(map: "user_email_key")
  isActive                  Boolean                    @default(true)
  name                      String
  passwordHash              String?
  phone                     String?
  role                      String                     @default("STUDENT")
  updatedAt                 Timestamptz
  profilePhotoUrl           String?
  assessmentSubmissions     AssessmentSubmission[]
  ceoProfile                CeoProfile?
  certificates              Certificate[]
  enrollments               Enrollment[]
  liveSessionParticipations LiveSessionParticipation[]
  payments                  Payment[]
  studentProfile            StudentProfile?
  trainerActivities         TrainerActivity[]
  trainerProfile            TrainerProfile?
  assessments               Assessment[]               @relation(name: "assessment_createdByUserId_fkey")
  assessmentsAssessment     Assessment[]               @relation(name: "assessment_reviewedByUserId_fkey")
  courseModules             CourseModule[]             @relation(name: "courseModule_createdByUserId_fkey")
  courseModulesCourseModule CourseModule[]             @relation(name: "courseModule_reviewedByUserId_fkey")
  lessons                   Lesson[]                   @relation(name: "lesson_createdByUserId_fkey")
  lessonsLesson             Lesson[]                   @relation(name: "lesson_reviewedByUserId_fkey")
  liveSessions              LiveSession[]              @relation(name: "liveSession_createdByUserId_fkey")
  liveSessionsLiveSession   LiveSession[]              @relation(name: "liveSession_reviewedByUserId_fkey")

  @@check(expression: "(role = ANY (ARRAY['ADMIN'::text, 'STUDENT'::text, 'TRAINER'::text]))", map: "user_role_check_660e0b26")
  @@map("user")
}

model Assessment {
  id                    Int                    @id(map: "assessment_pkey") @default(autoincrement())
  courseId              Int
  createdAt             Timestamptz            @default(now())
  description           String?
  dueAt                 Timestamptz?
  durationMinutes       Int?
  instructions          String?
  isActive              Boolean                @default(true)
  title                 String
  totalMarks            Int                    @default(100)
  _type                 String                 @map("type")
  updatedAt             Timestamptz
  approvalStatus        String                 @default("PUBLISHED")
  createdByUserId       Int?
  rejectionReason       String?
  reviewedAt            Timestamptz?
  reviewedByUserId      Int?
  assessmentQuestions   AssessmentQuestion[]
  assessmentSubmissions AssessmentSubmission[]
  course                Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade, map: "assessment_courseId_fkey")
  createdByUser         User?                  @relation(name: "assessment_createdByUserId_fkey", fields: [createdByUserId], references: [id], onDelete: SetNull, map: "assessment_createdByUserId_fkey")
  reviewedByUser        User?                  @relation(name: "assessment_reviewedByUserId_fkey", fields: [reviewedByUserId], references: [id], onDelete: SetNull, map: "assessment_reviewedByUserId_fkey")

  @@index([approvalStatus], name: "assessment_approvalStatus_idx")
  @@index([courseId], name: "assessment_courseId_idx")
  @@index([courseId, isActive], name: "assessment_courseId_isActive_idx")
  @@index([createdByUserId], name: "assessment_createdByUserId_idx")
  @@index([dueAt], name: "assessment_dueAt_idx")
  @@index([reviewedByUserId], name: "assessment_reviewedByUserId_idx")
  @@index([_type], name: "assessment_type_idx")
  @@check(expression: "(\"approvalStatus\" = ANY (ARRAY['DRAFT'::text, 'PENDING_REVIEW'::text, 'REJECTED'::text, 'PUBLISHED'::text, 'ARCHIVED'::text]))", map: "assessment_approvalStatus_check_5f777b7a")
  @@check(expression: "(type = ANY (ARRAY['ASSIGNMENT'::text, 'QUIZ'::text]))", map: "assessment_type_check_65240a52")
  @@map("assessment")
}

model AssessmentQuestion {
  id            Int         @id(map: "assessmentQuestion_pkey") @default(autoincrement())
  assessmentId  Int
  correctAnswer String?
  createdAt     Timestamptz @default(now())
  marks         Int         @default(1)
  optionA       String?
  optionB       String?
  optionC       String?
  optionD       String?
  question      String
  sortOrder     Int         @default(0)
  updatedAt     Timestamptz
  assessment    Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade, map: "assessmentQuestion_assessmentId_fkey")

  @@index([assessmentId], name: "assessmentQuestion_assessmentId_idx")
  @@index([assessmentId, sortOrder], name: "assessmentQuestion_assessmentId_sortOrder_idx")
  @@map("assessmentQuestion")
}

model AssessmentSubmission {
  id                 Int          @id(map: "assessmentSubmission_pkey") @default(autoincrement())
  answers            String?
  assessmentId       Int
  attemptNumber      Int          @default(1)
  createdAt          Timestamptz  @default(now())
  feedback           String?
  gradedAt           Timestamptz?
  score              Int?
  startedAt          Timestamptz?
  status             String       @default("IN_PROGRESS")
  submissionComment  String?
  submissionFileName String?
  submissionFileUrl  String?
  submittedAt        Timestamptz?
  updatedAt          Timestamptz
  userId             Int
  assessment         Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade, map: "assessmentSubmission_assessmentId_fkey")
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade, map: "assessmentSubmission_userId_fkey")

  @@unique([assessmentId, userId, attemptNumber], map: "assessmentSubmission_assessmentId_userId_attemptNumber_key")
  @@index([assessmentId], name: "assessmentSubmission_assessmentId_idx")
  @@index([assessmentId, userId], name: "assessmentSubmission_assessmentId_userId_idx")
  @@index([status], name: "assessmentSubmission_status_idx")
  @@index([userId], name: "assessmentSubmission_userId_idx")
  @@check(expression: "(status = ANY (ARRAY['IN_PROGRESS'::text, 'SUBMITTED'::text, 'GRADED'::text]))", map: "assessmentSubmission_status_check_7aef1854")
  @@map("assessmentSubmission")
}

model TrainerProfile {
  id                       Int                       @id(map: "trainerProfile_pkey") @default(autoincrement())
  bio                      String?
  createdAt                Timestamptz               @default(now())
  experience               Int?
  qualification            String?
  specialization           String?
  updatedAt                Timestamptz
  userId                   Int                       @unique(map: "trainerProfile_userId_key")
  batches                  Batch[]
  liveSessions             LiveSession[]
  trainerActivities        TrainerActivity[]
  trainerCoursePermissions TrainerCoursePermission[]
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "trainerProfile_userId_fkey")

  @@map("trainerProfile")
}

model Batch {
  id            Int             @id(map: "batch_pkey") @default(autoincrement())
  courseId      Int
  createdAt     Timestamptz     @default(now())
  endDate       Timestamptz
  maxStudents   Int             @default(30)
  mode          String          @default("OFFLINE")
  name          String
  startDate     Timestamptz
  status        String          @default("UPCOMING")
  trainerId     Int?
  updatedAt     Timestamptz
  batchStudents BatchStudent[]
  course        Course          @relation(fields: [courseId], references: [id], onDelete: Cascade, map: "batch_courseId_fkey")
  trainer       TrainerProfile? @relation(fields: [trainerId], references: [id], onDelete: SetNull, map: "batch_trainerId_fkey")

  @@index([courseId], name: "batch_courseId_idx")
  @@index([courseId, status], name: "batch_courseId_status_idx")
  @@index([endDate], name: "batch_endDate_idx")
  @@index([startDate], name: "batch_startDate_idx")
  @@index([status], name: "batch_status_idx")
  @@index([trainerId], name: "batch_trainerId_idx")
  @@check(expression: "(mode = ANY (ARRAY['ONLINE'::text, 'OFFLINE'::text, 'HYBRID'::text]))", map: "batch_mode_check_8ab134e1")
  @@check(expression: "(status = ANY (ARRAY['UPCOMING'::text, 'ACTIVE'::text, 'COMPLETED'::text, 'INACTIVE'::text]))", map: "batch_status_check_30cd2ac0")
  @@map("batch")
}

model StudentProfile {
  id                   Int            @id(map: "studentProfile_pkey") @default(autoincrement())
  createdAt            Timestamptz    @default(now())
  referralId           String?
  state                String?
  studentId            String         @unique(map: "studentProfile_studentId_key")
  updatedAt            Timestamptz
  userId               Int            @unique(map: "studentProfile_userId_key")
  address              String?
  city                 String?
  dateOfBirth          String?
  declarationAccepted  Boolean        @default(false)
  deviceTypes          String?
  gender               String?
  guardianEmail        String?
  guardianMobile       String?
  guardianName         String?
  guardianRelationship String?
  guardianWhatsapp     String?
  internetFacility     String?
  organization         String?
  pin                  String?
  preferredClassApp    String?
  qualification        String?
  referralMobile       String?
  referralName         String?
  referralSource       String?
  batchStudents        BatchStudent[]
  enrollments          Enrollment[]
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade, map: "studentProfile_userId_fkey")

  @@map("studentProfile")
}

model BatchStudent {
  id          Int            @id(map: "batchStudent_pkey") @default(autoincrement())
  assignedAt  Timestamptz    @default(now())
  batchId     Int
  completedAt Timestamptz?
  studentId   Int
  batch       Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade, map: "batchStudent_batchId_fkey")
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade, map: "batchStudent_studentId_fkey")

  @@unique([batchId, studentId], map: "batchStudent_batchId_studentId_key")
  @@index([batchId], name: "batchStudent_batchId_idx")
  @@index([batchId, studentId], name: "batchStudent_batchId_studentId_idx")
  @@index([studentId], name: "batchStudent_studentId_idx")
  @@map("batchStudent")
}

model CeoProfile {
  id            Int         @id(map: "ceoProfile_pkey") @default(autoincrement())
  bioParagraph1 String
  bioParagraph2 String
  createdAt     Timestamptz @default(now())
  designation   String      @default("Founder & CEO")
  highlight1    String
  highlight2    String
