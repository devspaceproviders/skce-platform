  packageId Int
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade, map: "packageCourse_courseId_fkey")
  package   CoursePackage @relation(fields: [packageId], references: [id], onDelete: Cascade, map: "packageCourse_packageId_fkey")

  @@unique([packageId, courseId], map: "packageCourse_packageId_courseId_key")
  @@index([courseId], name: "packageCourse_courseId_idx")
  @@index([packageId], name: "packageCourse_packageId_idx")
  @@map("packageCourse")
}

