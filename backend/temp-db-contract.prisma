  @@index([courseId], name: "courseModule_courseId_idx")
  @@index([courseId, sortOrder], name: "courseModule_courseId_sortOrder_idx")
  @@index([createdByUserId], name: "courseModule_createdByUserId_idx")
  @@index([reviewedByUserId], name: "courseModule_reviewedByUserId_idx")
  @@check(expression: "(\"approvalStatus\" = ANY (ARRAY['DRAFT'::text, 'PENDING_REVIEW'::text, 'REJECTED'::text, 'PUBLISHED'::text, 'ARCHIVED'::text]))", map: "courseModule_approvalStatus_check_5f777b7a")
  @@map("courseModule")
}

model Lesson {
  id               Int              @id(map: "lesson_pkey") @default(autoincrement())
  content          String?
  createdAt        Timestamptz      @default(now())
  description      String?
  documentUrl      String?
  isActive         Boolean          @default(true)
  moduleId         Int
  sortOrder        Int              @default(0)
  title            String
  updatedAt        Timestamptz
  videoUrl         String?
  approvalStatus   String           @default("PUBLISHED")
  createdByUserId  Int?
  rejectionReason  String?
  reviewedAt       Timestamptz?
  reviewedByUserId Int?
  lessonProgresses LessonProgress[]
  createdByUser    User?            @relation(name: "lesson_createdByUserId_fkey", fields: [createdByUserId], references: [id], onDelete: SetNull, map: "lesson_createdByUserId_fkey")
  module           CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade, map: "lesson_moduleId_fkey")
  reviewedByUser   User?            @relation(name: "lesson_reviewedByUserId_fkey", fields: [reviewedByUserId], references: [id], onDelete: SetNull, map: "lesson_reviewedByUserId_fkey")

  @@index([approvalStatus], name: "lesson_approvalStatus_idx")
  @@index([createdByUserId], name: "lesson_createdByUserId_idx")
  @@index([moduleId], name: "lesson_moduleId_idx")
  @@index([moduleId, sortOrder], name: "lesson_moduleId_sortOrder_idx")
  @@index([reviewedByUserId], name: "lesson_reviewedByUserId_idx")
  @@check(expression: "(\"approvalStatus\" = ANY (ARRAY['DRAFT'::text, 'PENDING_REVIEW'::text, 'REJECTED'::text, 'PUBLISHED'::text, 'ARCHIVED'::text]))", map: "lesson_approvalStatus_check_5f777b7a")
  @@map("lesson")
}

model LessonProgress {
  id          Int          @id(map: "lessonProgress_pkey") @default(autoincrement())
  completedAt Timestamptz?
  createdAt   Timestamptz  @default(now())
  lessonId    Int
  startedAt   Timestamptz?
  status      String       @default("NOT_STARTED")
  updatedAt   Timestamptz
  userId      Int
  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade, map: "lessonProgress_lessonId_fkey")

  @@unique([userId, lessonId], map: "lessonProgress_userId_lessonId_key")
  @@index([lessonId], name: "lessonProgress_lessonId_idx")
  @@index([userId], name: "lessonProgress_userId_idx")
  @@index([userId, status], name: "lessonProgress_userId_status_idx")
  @@map("lessonProgress")
}

model LiveSession {
  id                        Int                        @id(map: "liveSession_pkey") @default(autoincrement())
  courseId                  Int
  createdAt                 Timestamptz                @default(now())
  description               String?
  endAt                     Timestamptz
  isPublished               Boolean                    @default(false)
  meetingUrl                String?
  recordingUrl              String?
  startAt                   Timestamptz
  status                    String                     @default("SCHEDULED")
  title                     String
  trainerId                 Int
  updatedAt                 Timestamptz
  approvalStatus            String                     @default("PUBLISHED")
  createdByUserId           Int?
  rejectionReason           String?
  reviewedAt                Timestamptz?
  reviewedByUserId          Int?
