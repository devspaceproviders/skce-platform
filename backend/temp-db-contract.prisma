  issuedAt          Timestamptz    @default(now())
  updatedAt         Timestamptz
  userId            Int
  certificateType   String         @default("COURSE")
  packageId         Int?
  course            Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade, map: "certificate_courseId_fkey")
  enrollment        Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade, map: "certificate_enrollmentId_fkey")
  package           CoursePackage? @relation(fields: [packageId], references: [id], onDelete: Cascade, map: "certificate_packageId_fkey")
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade, map: "certificate_userId_fkey")

  @@index([certificateType], name: "certificate_certificateType_idx")
  @@index([courseId], name: "certificate_courseId_idx")
  @@index([enrollmentId], name: "certificate_enrollmentId_idx")
  @@index([packageId], name: "certificate_packageId_idx")
  @@index([userId], name: "certificate_userId_idx")
  @@map("certificate")
}

