  course                    Course                     @relation(fields: [courseId], references: [id], onDelete: Cascade, map: "liveSession_courseId_fkey")
  createdByUser             User?                      @relation(name: "liveSession_createdByUserId_fkey", fields: [createdByUserId], references: [id], onDelete: SetNull, map: "liveSession_createdByUserId_fkey")
  reviewedByUser            User?                      @relation(name: "liveSession_reviewedByUserId_fkey", fields: [reviewedByUserId], references: [id], onDelete: SetNull, map: "liveSession_reviewedByUserId_fkey")
