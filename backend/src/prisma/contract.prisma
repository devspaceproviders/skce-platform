  name    String
  email   String
  phone   String
  message String

  status ContactMessageStatus @default(NEW)

  createdAt TimestamptzString       @default(now())
  updatedAt temporal.updatedAtString()

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([createdAt])
}